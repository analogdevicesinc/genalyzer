set -eu

fftw_dylib=/opt/homebrew/opt/fftw/lib/libfftw3.3.dylib
if [[ ! -r "$fftw_dylib" ]]; then
	printf '%s\n' \
		'libgenalyzer requires the Homebrew fftw formula.' \
		'Install it before this package:' \
		'  brew install fftw' >&2
	exit 1
fi
exit 0
