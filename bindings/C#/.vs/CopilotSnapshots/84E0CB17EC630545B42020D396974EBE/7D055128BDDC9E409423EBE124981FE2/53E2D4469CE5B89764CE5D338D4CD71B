// C# port of bindings/python/examples/gn_doc_spectral_analysis1.py
//
// Demonstrates complex FFT spectral analysis with NO_WINDOW (coherent)
// frequency, automatic max-tone detection, harmonic analysis, and result
// annotations using the Genalyzer C# bindings.
// Run independently: dotnet run --project SpectralAnalysis1.csproj

using System;
using System.Collections.Generic;
using Genalyzer;

// ---------------------------------------------------------------------------
// Signal parameters
// ---------------------------------------------------------------------------
int    npts        = 30000;
double freq        = 300_000.0;       // tone frequency (Hz)
double phase       = 0.0;
double amplDbfs    = -1.0;
double qnoiseDbfs  = -60.0;
double fsr         = 2.0;
double ampl        = (fsr / 2) * Math.Pow(10.0, amplDbfs  / 20.0);
double qnoise      = Math.Pow(10.0, qnoiseDbfs / 20.0);

// ---------------------------------------------------------------------------
// FFT configuration
// ---------------------------------------------------------------------------
int  navg         = 1;
int  nfft         = npts / navg;
int  qres         = 12;
var  codeFmt      = CodeFormat.TwosComplement;
var  window       = Window.NoWindow;
int  ssbFund      = 0;
var  axisType     = FreqAxisType.DcCenter;
double fs         = 3e6;
var  axisFmt      = FreqAxisFormat.Freq;
int  numHarmonics = 3;
int  ssbRest      = 0;
int  ssbDc        = 0;
int  ssbWo        = 0;

// ---------------------------------------------------------------------------
// Generate I/Q signal and compute FFT
// ---------------------------------------------------------------------------
double[] awfi = Waveforms.Cos(npts, fs, ampl, freq, phase);
double[] awfq = Waveforms.Sin(npts, fs, ampl, freq, phase);
short[]  qwfi = SignalProcessing.Quantize16(awfi, fsr, qres, qnoise, codeFmt);
short[]  qwfq = SignalProcessing.Quantize16(awfq, fsr, qres, qnoise, codeFmt);

double[] fftCplx = FourierTransforms.Fft(qwfi, qwfq, qres, navg, nfft, window, codeFmt);

// ---------------------------------------------------------------------------
// Fourier analysis configuration
// ---------------------------------------------------------------------------
const string key = "fa";
Manager.Remove(key);
FourierAnalysis.Create(key);
FourierAnalysis.AddMaxTone(key, "A", FACompTag.Signal, ssbFund);
FourierAnalysis.SetFsample(key, fs);
FourierAnalysis.SetHd(key, numHarmonics);
FourierAnalysis.SetSsb(key, FASsb.Default, ssbRest);
FourierAnalysis.SetSsb(key, FASsb.DC,      ssbDc);
FourierAnalysis.SetSsb(key, FASsb.WO,      ssbWo);

// ---------------------------------------------------------------------------
// Fourier analysis execution
// ---------------------------------------------------------------------------
Dictionary<string, double> results = FourierAnalysis.Analyze(key, fftCplx, nfft, axisType);

// ---------------------------------------------------------------------------
// Print annotation labels table
// ---------------------------------------------------------------------------
double[] freqAxis = FourierUtilities.FreqAxis(nfft, axisType, fs, axisFmt);
double[] fftDb    = ArrayOps.Db(fftCplx);
if (axisType == FreqAxisType.DcCenter)
    fftDb = FourierUtilities.FftShift(fftDb);

var annots = FourierAnalysis.Annotations(results, axisType, axisFmt);

Console.WriteLine("annots[\"labels\"]:");
Console.WriteLine($"  {"frequency (Hz)",16}  {"magnitude (dBFS)",18}  {"label",-8}");
Console.WriteLine(new string('-', 52));
foreach (var lbl in annots.Labels)
    Console.WriteLine($"  {lbl.Freq,16:F2}  {lbl.Magnitude,18:F4}  {lbl.Tag,-8}");

Console.WriteLine();
Console.WriteLine("annots[\"tone_boxes\"] (left boundary Hz, width Hz):");
Console.WriteLine($"  {"left (Hz)",16}  {"width (Hz)",16}");
Console.WriteLine(new string('-', 38));
foreach (var box in annots.ToneBoxes)
    Console.WriteLine($"  {box.X,16:F2}  {box.Width,16:F2}");

Console.WriteLine();
Console.WriteLine("+----------------+");
Console.WriteLine("results dictionary");
Console.WriteLine("+----------------+");
foreach (var kv in results)
    Console.WriteLine($"  {kv.Key,-26} {kv.Value,16:F6}");

// ---------------------------------------------------------------------------
// Key metrics
// ---------------------------------------------------------------------------
double snr   = results["snr"];
double fsnr  = results["fsnr"];
double sinad = results["sinad"];
double sfdr  = results["sfdr"];
double abn   = results["abn"];
double nsd   = results["nsd"];

Console.WriteLine();
Console.WriteLine($"SNR   = {snr:F4} dB");
Console.WriteLine($"FSNR  = {fsnr:F4} dB");
Console.WriteLine($"SINAD = {sinad:F4} dB");
Console.WriteLine($"SFDR  = {sfdr:F4} dB");
Console.WriteLine($"ABN   = {abn:F4} dB");
Console.WriteLine($"NSD   = {nsd:F4} dB");
